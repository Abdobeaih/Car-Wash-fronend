# Frontend environment — copy to .env.local
# Local development: point at the local NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Deployment (set in your hosting provider's environment, e.g. Vercel project env vars):
# API_URL=<your deployed API URL, e.g. https://car-wash-api.vercel.app>
# The browser talks to the same origin via /api/* (a Next.js runtime proxy), so no
# NEXT_PUBLIC_API_URL is required in production. The proxy reads API_URL at runtime.